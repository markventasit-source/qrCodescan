# MongoDB Atlas - replace USER, PASSWORD and keep the database name (qr_tracker) after the slash.
# If PASSWORD has special characters (@ : / ? # %), URL-encode them (e.g. @ -> %40).
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.vdmfhwr.mongodb.net/qr_tracker?retryWrites=true&w=majority"

# Public domain where this app runs (used inside the QR code). No trailing slash.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# App URL for metadata and Open Graph tags (should match your production domain)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
