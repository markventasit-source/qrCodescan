<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1f2937;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#111827;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="qrGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10b981;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#059669;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <rect width="1200" height="630" fill="url(#bgGrad)"/>
  
  <!-- Background pattern -->
  <g opacity="0.1">
    <rect x="50" y="50" width="30" height="30" fill="white" rx="2"/>
    <rect x="90" y="50" width="20" height="30" fill="white" rx="2"/>
    <rect x="1000" y="500" width="30" height="30" fill="white" rx="2"/>
    <rect x="1040" y="500" width="20" height="30" fill="white" rx="2"/>
  </g>
  
  <!-- Main QR Code Icon -->
  <g transform="translate(200, 165)">
    <rect x="0" y="0" width="60" height="60" fill="white" rx="4"/>
    <rect x="75" y="0" width="45" height="60" fill="white" rx="4"/>
    <rect x="135" y="0" width="60" height="60" fill="white" rx="4"/>
    
    <rect x="0" y="75" width="45" height="45" fill="white" rx="4"/>
    <rect x="60" y="75" width="60" height="45" fill="white" rx="4"/>
    <rect x="135" y="75" width="60" height="45" fill="white" rx="4"/>
    
    <rect x="0" y="135" width="60" height="60" fill="white" rx="4"/>
    <rect x="75" y="135" width="45" height="60" fill="white" rx="4"/>
    <rect x="135" y="135" width="60" height="60" fill="white" rx="4"/>
    
    <!-- Center accent with checkmark -->
    <rect x="70" y="70" width="90" height="90" fill="url(#qrGrad)" rx="8"/>
    <path d="M 90 115 L 110 135 L 140 95" stroke="white" stroke-width="10" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  </g>
  
  <!-- Text -->
  <text x="500" y="260" font-family="system-ui, -apple-system, sans-serif" font-size="80" font-weight="700" fill="white">
    QR Code Tracker
  </text>
  <text x="500" y="340" font-family="system-ui, -apple-system, sans-serif" font-size="36" font-weight="400" fill="#9ca3af">
    Create, track, and manage your QR codes
  </text>
  
  <!-- Feature badges -->
  <g transform="translate(500, 380)">
    <rect x="0" y="0" width="140" height="40" rx="20" fill="#10b981" opacity="0.2"/>
    <text x="70" y="27" font-family="system-ui, -apple-system, sans-serif" font-size="18" font-weight="600" fill="#10b981" text-anchor="middle">
      Analytics
    </text>
    
    <rect x="160" y="0" width="120" height="40" rx="20" fill="#10b981" opacity="0.2"/>
    <text x="220" y="27" font-family="system-ui, -apple-system, sans-serif" font-size="18" font-weight="600" fill="#10b981" text-anchor="middle">
      Simple
    </text>
    
    <rect x="300" y="0" width="110" height="40" rx="20" fill="#10b981" opacity="0.2"/>
    <text x="355" y="27" font-family="system-ui, -apple-system, sans-serif" font-size="18" font-weight="600" fill="#10b981" text-anchor="middle">
      Fast
    </text>
  </g>
</svg>